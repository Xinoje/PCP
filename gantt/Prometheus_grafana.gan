        <task id="0" uid="9159242f8b7c4ee4acc2f43ba54ae0be" name="Prise en main de l'environnement Prometheus/Grafana existant" meeting="false" start="2026-01-19" duration="2" complete="0" expand="true">
            <notes><![CDATA[Prise en main de l'environnement Prometheus et Grafana déjà existant à Fougères Agglomération. Découverte des interfaces et compréhension de l'architecture.]]></notes>
        </task>
        <task id="1" uid="a59ba1bb698d49d9bd5df3d3f811d0b8" name="Configuration du fichier prometheus.yml (targets Adista)" meeting="false" start="2026-01-21" duration="5" complete="0" expand="true">
            <notes><![CDATA[Configuration du fichier prometheus.yml avec l'ajout des targets correspondant aux équipements du prestataire Adista (adresses IP, labels, job, paramètres d'authentification).]]></notes>
        </task>
        <task id="2" uid="d0f39a6c442e4c8da81d945c15bb0e13" name="Configuration du fichier snmp.yml (modules SNMP)" meeting="false" start="2026-01-27" duration="4" complete="0" expand="true"/>
        <task id="4" uid="2d24f0065c83448fb7ebe74964c20440" name="Relance et vérification du snmp_exporter" meeting="false" start="2026-01-30" duration="2" complete="0" expand="true">
            <notes><![CDATA[Relance du service snmp_exporter et vérification de son bon fonctionnement via les logs système.]]></notes>
        </task>
        <task id="5" uid="5e3865800073432bafbdfb7aee5ca9d1" name="Vérification du scraping via l'interface Web Prometheus" meeting="false" start="2026-02-02" duration="3" complete="0" expand="true">
            <notes><![CDATA[Vérification du scraping via l'interface Web Prometheus (menu Status → Targets) pour confirmer que les équipements Adista sont bien en état "UP".]]></notes>
        </task>
        <task id="6" uid="b883807417a24b769b6da6c5fff4ef4a" name="Requêtes PromQL de test (up{job=&quot;ADISTA&quot;})" meeting="false" start="2026-02-04" duration="3" complete="0" expand="true">
            <notes><![CDATA[Réalisation de requêtes PromQL de test, notamment up{job="ADISTA"}, pour valider la collecte des métriques en format brut.]]></notes>
        </task>
        <task id="7" uid="4165ec321e3c41e785d48617893dc2bf" name="Création du tableau de bord Grafana" meeting="false" start="2026-02-06" duration="6" complete="0" expand="true">
            <notes><![CDATA[Création d'un tableau de bord Grafana dédié à Adista, avec visualisation en format tableau, ajout des sources de données et personnalisation.]]></notes>
        </task>
        <task id="8" uid="4e88d899b87d4e13a4f7ae51a75628d9" name="Application des transformations pour l'affichage" meeting="false" start="2026-02-13" duration="4" complete="0" expand="true">
            <notes><![CDATA[Application de transformations dans Grafana pour améliorer l'affichage des métriques (regroupement des labels, séparation des colonnes, filtres).]]></notes>
        </task>
        <task id="9" uid="9b7b6d32d126420bb50c9458f82d70dd" name="Validation finale et livraison" meeting="false" start="2026-02-18" duration="3" complete="0" expand="true">
            <notes><![CDATA[Validation finale par l'équipe, corrections éventuelles et livraison du tableau de bord opérationnel.]]></notes>
        </task>
